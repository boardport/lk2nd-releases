; This file is for unifying the coding style for different editors and IDEs.
; More information at http://editorconfig.org

root = true

[*]
charset = utf-8
indent_size = 4
indent_style = space
end_of_line = lf
insert_final_newline = false
trim_trailing_whitespace = true

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2
insert_final_newline = true

[*.md]
indent_style = space
indent_size = 2
max_line_length = 150
trim_trailing_whitespace = true
insert_final_newline = true
