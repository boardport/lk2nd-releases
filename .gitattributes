# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text formats
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary files
*.bin binary
*.img binary
*.mbn binary
*.tar.gz binary
*.zip binary

# Export-ignore metadata files when generating archives
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.markdownlint-cli2.jsonc export-ignore
.aiignore export-ignore
.github export-ignore
